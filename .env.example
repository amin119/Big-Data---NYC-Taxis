# ── Grafana ────────────────────────────────────────────────────────────────────
GRAFANA_PORT=3001

# ── Airflow ────────────────────────────────────────────────────────────────────
AIRFLOW_PORT=8888

# ── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_BROKER=localhost:9092
TOPIC_TRIPS=taxi-trips
TOPIC_WEATHER=taxi-weather

# ── Cassandra ──────────────────────────────────────────────────────────────────
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=taxi_streaming

# ── Cloudflare R2 ──────────────────────────────────────────────────────────────
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET=<your-bucket-name>

# ── Data Lake zones (R2 paths) ─────────────────────────────────────────────────
R2_RAW_TRIPS=raw/trips
R2_RAW_WEATHER=raw/weather
R2_PROCESSED=processed/trips_clean
R2_BATCH_RESULTS=batch_results
R2_MODELS=models
R2_CHECKPOINTS=checkpoints

# ── Dataset range ──────────────────────────────────────────────────────────────
START_YEAR=2022
# END_YEAR not set → uses datetime.now().year automatically

# ── Producer tuning ────────────────────────────────────────────────────────────
REPLAY_DELAY=0.05
WEATHER_EVERY_N=500
